/* 고깃ZIP resources (UTF-8) */
#pragma code_page(65001)
#include <windows.h>
#include "../src/core/version.h"

1   ICON    "app.ico"
2   ICON    "doc.ico"
100 RCDATA  "assets.bin"
1   24      "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     GZ_VER_MAJOR,GZ_VER_MINOR,GZ_VER_PATCH,0
PRODUCTVERSION  GZ_VER_MAJOR,GZ_VER_MINOR,GZ_VER_PATCH,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204b0"
        BEGIN
            VALUE "CompanyName",      "Butcherar"
            VALUE "FileDescription",  "고깃ZIP - 가볍고 빠른 압축 프로그램"
            VALUE "FileVersion",      GZ_APP_VERSION
            VALUE "InternalName",     "GogitZip"
            VALUE "LegalCopyright",   "© 2026 Butcherar project. MIT License."
            VALUE "OriginalFilename", "GogitZip.exe"
            VALUE "ProductName",      "고깃ZIP (GogitZIP)"
            VALUE "ProductVersion",   GZ_APP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0412, 1200
    END
END
