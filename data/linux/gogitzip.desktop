[Desktop Entry]
Type=Application
Version=1.0
Name=GogitZIP
Name[ko]=고깃ZIP
GenericName=Archive Manager
GenericName[ko]=압축 프로그램
Comment=Open, extract and create archives
Comment[ko]=압축 파일을 열고, 풀고, 새로 만듭니다
Keywords=zip;7z;rar;tar;archive;extract;compress;압축;압축풀기;
Exec=gogitzip-gtk %F
TryExec=gogitzip-gtk
Icon=gogitzip
Terminal=false
StartupNotify=true
StartupWMClass=gogitzip-gtk
Categories=GTK;Utility;Archiving;Compression;
MimeType=application/zip;application/x-zip-compressed;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-rar-volume;application/x-alz;application/x-egg;application/x-split-archive;application/x-tar;application/gzip;application/x-gzip;application/x-compressed-tar;application/x-tarz;application/x-bzip2;application/x-bzip;application/x-bzip2-compressed-tar;application/x-bzip-compressed-tar;application/x-bzip1-compressed-tar;application/x-xz;application/x-xz-compressed-tar;application/x-lzma;application/x-lzma-compressed-tar;application/x-lzip;application/zstd;application/x-zstd-compressed-tar;application/x-lz4;application/x-lz4-compressed-tar;application/x-lzop;application/x-tzo;application/x-compress;application/vnd.ms-cab-compressed;application/x-cd-image;application/x-iso9660-image;application/x-udf-image;application/x-raw-disk-image;application/x-arj;application/x-lha;application/x-lzh-compressed;application/x-cpio;application/x-rpm;application/vnd.debian.binary-package;application/x-deb;application/x-ipk;application/x-archive;application/x-ms-wim;application/x-apple-diskimage;application/x-xar;application/vnd.squashfs;application/vnd.snap;application/x-cramfs-image;application/x-vhd-disk;application/x-vhdx-disk;application/x-vmdk-disk;application/x-qemu-disk;application/x-vdi-disk;application/x-virtualbox-vdi;application/x-msi;application/x-ole-storage;application/x-ms-patch;application/x-ms-transform;application/x-msm;application/x-nsis;application/x-raw-floppy-disk-image;application/x-ext2-image;application/x-ext3-image;application/x-ext4-image;application/x-exfat-image;application/x-ntfs-image;application/x-android-sparse-image;application/x-ace;application/x-zoo;application/x-arc;application/x-stuffit;application/x-hfs-image;application/x-apfs-image;application/vnd.ms-htmlhelp;application/x-java-archive;application/java-archive;application/vnd.android.package-archive;application/epub+zip;application/x-xpinstall;
Actions=new-archive;

[Desktop Action new-archive]
Name=New archive
Name[ko]=새로 압축
Exec=gogitzip-gtk --compress
